# Shared development server settings
POSTGRES_DB=zentryx
POSTGRES_USER=zentryx
POSTGRES_PASSWORD=replace-with-a-random-hex-value

# Bind the API only to the server's Tailscale IP.
API_BIND_IP=100.x.x.x
API_PORT=5000

DB_POOL_MIN=1
DB_POOL_MAX=10

# Optional settings used only by: docker compose --profile demo up -d
SIM_DEVICE_ID=gps-demo-01
SIM_VEHICLE_ID=unit-demo-01
SIM_ROUTE_ID=route-l2
SIM_SPEED_MPS=8.0
SIM_INTERVAL_SECONDS=2.0
SIM_START_PROGRESS_M=1200
