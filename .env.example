# Docker Compose settings; use only example values here
POSTGRES_DB=zentryx
POSTGRES_USER=zentryx
POSTGRES_PASSWORD=replace-with-a-random-hex-value

# Local development: loopback. On the shared server use its Tailscale IP.
API_BIND_IP=127.0.0.1
API_PORT=5000

DB_POOL_MIN=1
DB_POOL_MAX=10

# Optional settings used only by: docker compose --profile demo up -d
SIM_DEVICE_ID=gps-demo-01
SIM_VEHICLE_ID=unit-demo-01
SIM_ROUTE_ID=route-l2
SIM_SPEED_MPS=8.0
SIM_INTERVAL_SECONDS=2.0
SIM_START_PROGRESS_M=1200

# Flask outside Docker requires an explicit reachable database URL:
# POSTGRES_URL=postgresql://example_user:example_password@127.0.0.1:5432/zentryx
# Frontend variables are exported in the shell/IDE, not read from this file:
# ZENTRYX_API_BASE_URL=http://127.0.0.1:5000
# ZENTRYX_SERVICE_ID=l2-ordinary
# ZENTRYX_VEHICLE_ID=unit-demo-01
# TEST_DATABASE_URL is only for a disposable database ending in _test.
